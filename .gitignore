# ROM binaries and firmware (far too large for git)
base-firmware/**/*.zip
base-firmware/**/*.img
roms/*/base/*.img
roms/*/target/*.img
# Target ROM archives (ColorOS OTA is currently under base/)
roms/*/base/*.zip
roms/*/target/*.zip
roms/*/merged/*
roms/*/build/*
!roms/*/merged/.gitkeep
!roms/*/build/.gitkeep

# Extracted / intermediate artifacts
*.new.dat
*.new.dat.br
*.transfer.list
*.patch.dat
*.raw
*.sparse
*.ext4

# Logs
roms/*/logs/*.log
roms/*/logs/*.txt

# Agent locks (ephemeral)
agents/locks/*
!agents/locks/.gitkeep

# Temp
*.tmp
*.bak
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Option A staging (above data/ only)
roms/coloros/merged/optA/

